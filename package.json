{
  "name": "nile-bridge",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=packages/backend\" \"npm run dev --workspace=packages/frontend\"",
    "build": "npm run build --workspace=packages/backend && npm run build --workspace=packages/frontend",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace=packages/backend",
    "db:migrate": "npm run migrate --workspace=packages/backend",
    "db:seed": "npm run db:seed --workspace=packages/backend",
    "test": "npm install && npm run test --workspace=packages/backend && npm run test --workspace=packages/frontend",
    "test:backend": "npm run test --workspace=packages/backend",
    "test:frontend": "npm run test --workspace=packages/frontend"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}